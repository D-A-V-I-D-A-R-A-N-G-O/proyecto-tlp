# =============================================================
#                 SNAKE EVOLVED - BRICKSCRIPT
# =============================================================

GAME_TYPE SNAKE

GAME_GRID (20, 20)

# --- Configuración de Niveles ---
LEVELS:
  LEVEL BABY:
    TICK_SPEED 150
    ENABLE_POISON FALSE
    ENABLE_CLOUDS FALSE
    INVINCIBILITY_TIME 0
  END
  LEVEL ENTUSIASTA:
    TICK_SPEED 100
    ENABLE_POISON TRUE
    ENABLE_CLOUDS FALSE
    INVINCIBILITY_TIME 5
  END
  LEVEL NYAN_CAT:
    TICK_SPEED 60
    ENABLE_POISON TRUE
    ENABLE_CLOUDS TRUE
    INVINCIBILITY_TIME 8
  END
END

# --- Definición de Formas Geométricas para la Serpiente ---
DEFINE SHAPE SNAKE_BODY:
  GEOMETRY CIRCULAR
  COLOR 00FF00
END

DEFINE SHAPE SNAKE_HEAD:
  GEOMETRY NYAN_HEAD
  COLOR FFC0CB
END

# --- Eventos y Lógica del Juego ---
ON START:
  SPAWN PLAYER AT (10, 10)
  SPAWN FOOD AT RANDOM
  SPAWN POISON_FOOD AT RANDOM
  SPAWN CLOUD_OBSTACLE AT RANDOM
END

ON TICK:
  MOVE PLAYER FORWARD
END

ON EAT_FOOD:
  INCREASE_SCORE 10
  GROW PLAYER 1
  SPAWN FOOD AT RANDOM
END

ON EAT_POISON:
  DECREASE_SCORE 20
  SPAWN POISON_FOOD AT RANDOM
END

ON COLLISION_CLOUD:
  DECREASE_SCORE 100
END

ON COLLISION_WALL:
  GAME_OVER
END

ON COLLISION_SELF:
  GAME_OVER
END

# --- Controles ---
ON KEY_LEFT:
  SET_DIRECTION LEFT
END

ON KEY_RIGHT:
  SET_DIRECTION RIGHT
END

ON KEY_UP:
  SET_DIRECTION UP
END

ON KEY_DOWN:
  SET_DIRECTION DOWN
END